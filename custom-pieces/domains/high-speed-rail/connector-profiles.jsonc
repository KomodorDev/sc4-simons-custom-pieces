// title: "High-speed rail connector profiles"
// summary: "Supply reviewed rail boundary and channel defaults for authored connector declarations without inferring neighbour compatibility."
//
// Used when: Authored connector-groups.jsonc records inherit a reviewed rail profile during connector validation, export, or overview generation.
// Read by: scp.connector_metadata.load_library loads and resolves these defaults through domain.jsonc; connector exports and scp.connector_overview use the resolved data. scp.preview and the connector tools include this file in source-freshness fingerprints.
// Updated by: The rail-domain maintainer authors reviewed profile defaults and inheritance after checking the actual boundary and channel measurements; no extraction command automatically invents or approves a profile.
// Affects: The effective network, height, direction, and boundary/channel defaults of connector declarations that reference these profiles. Names and inheritance do not prove physical fit, neighbour compatibility, or game operation; changing the source also invalidates dependent freshness checks.
// Reference: custom-pieces/docs/CONNECTOR_METADATA.md and custom-pieces/domains/high-speed-rail/NETWORK_SPEC.md.
{
  "schema_version": 2,
  "purpose": "Optional inherited authoring defaults for source-owned connection descriptions. Measurements and explicit physical channels decide boundary agreement; profile IDs are descriptive references.",
  "coordinate_convention": {
    "units": "metres",
    "axes": [
      "east",
      "north",
      "height"
    ],
    "orientation": "canonical 0 degrees",
    "seam_offset": "relative to the declared section origin; positive left when looking outward through the source tile boundary",
    "tile_metres": 16
  },
  "profiles": {
    "hsr-orth-scp-paired15-t2-opposed-rhd-v1": {
      "abstract": true,
      "network": "hsr",
      "engine_transport": 7,
      "role": "primary",
      "alignment": "orth",
      "endpoint_grade": 0.0
    },
    "hsr-l2-orth-scp-paired15-t2-opposed-rhd-v1": {
      "extends": "hsr-orth-scp-paired15-t2-opposed-rhd-v1",
      "abstract": false,
      "path_height_m": 15.5,
      "nominal_level": "l2",
      "label": "HSR L2 paired straight interface"
    },
    "hsr-l4-orth-scp-paired15-t2-opposed-rhd-v1": {
      "extends": "hsr-orth-scp-paired15-t2-opposed-rhd-v1",
      "abstract": false,
      "path_height_m": 30.5,
      "nominal_level": "l4",
      "label": "HSR L4 paired straight interface"
    },
    "hsr-h23000mm-orth-scp-paired15-t2-opposed-rhd-v1": {
      "extends": "hsr-orth-scp-paired15-t2-opposed-rhd-v1",
      "abstract": false,
      "path_height_m": 23.0,
      "nominal_level": null,
      "label": "HSR custom 23-metre paired interface",
      "scope_note": "Custom paired intermediate joint of the tight graded corner; not an alias for narrow L3 track."
    },
    "hsr-l2-paired-recessed-web15-t2-opposed-rhd-v1": {
      "extends": "hsr-orth-scp-paired15-t2-opposed-rhd-v1",
      "abstract": false,
      "path_height_m": 15.5,
      "nominal_level": "l2",
      "label": "HSR L2 paired interface with recessed structural web",
      "scope_note": "Measured fan-family concrete profile: 15 m outer slab and border envelope, with the exposed structural web approximately 6.963052 m from the centre at heights 14.590025–16.358057 m. The ordinary paired straight has its corresponding web approximately 7 m from the centre and is not a full physical-profile equivalent. Route height, two opposed channels, 4 m track spacing, and right-hand running remain unchanged. Complete saved-face evidence belongs to 01_assemblies/hsr-trumpet-straight-stem/evidence/fan-atomization-review.json; an inherited native-neighbour transition is recorded separately rather than declared universally compatible."
    }
  }
}
