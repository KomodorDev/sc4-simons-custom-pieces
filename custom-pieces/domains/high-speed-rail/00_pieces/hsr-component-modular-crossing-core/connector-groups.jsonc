// Purpose: Declare source-owned boundaries, physical channels, and measured-endpoint associations.
// Shared concepts and profile reference: ../../../../docs/CONNECTOR_METADATA.md
{
  "schema_version": 3, // Version of this metadata structure; distinct from the v1 in a profile ID.
  "purpose": "Authored physical channel identities and complete boundary bundles. Exact geometry and journeys remain measured from compiled game resources.",
  "piece_id": "hsr-component-modular-crossing-core", // Reusable piece type; each future placed copy has a separate instance ID.
  "source_binding": { // Exact file fingerprints make stale declarations detectable.
    "piece_sha256": "0087e27275a2c11ee126ce4254ded8a1f22eb18fe7448ae2b7062a4ef7a2a90f", // Fingerprint of this folder's piece.json definition.
    "connections_sha256": "e2eff89bdfc26e8713e1596a62f0754f4560c015973528afbfab70244d1d60ff" // Fingerprint of this folder's measured connections.json.
  },
  "components": [ // Logical route groups. Coordinates belong to source cells and paths, not component names.
    {
      "id": "upper-mainline", // Upper paired route, separate from the lower route.
      "network": "hsr" // High Speed Rail service; must agree with this component's profiles.
    },
    {
      "id": "lower-mainline", // Lower paired route; the crossing provides no transfer to the upper route.
      "network": "hsr" // High Speed Rail service; must agree with this component's profiles.
    }
  ],
  "channels": [ // Physical passages, separate from directed path records and their member IDs.
    {
      "id": "upper-channel-01", // Same channel at both ends; association follows actual permitted journeys.
      "component_id": "upper-mainline", // Logical route ownership, never a coordinate.
      "kind": "rail", // Physical passage kind; other domains can describe road lanes or walkways.
      "traffic_modes": ["monorail"] // Explicit game travel mode; the network service is separately HSR.
    },
    {
      "id": "upper-channel-02", // Same channel at both ends; association follows actual permitted journeys.
      "component_id": "upper-mainline", // Logical route ownership, never a coordinate.
      "kind": "rail", // Physical passage kind; other domains can describe road lanes or walkways.
      "traffic_modes": ["monorail"] // Explicit game travel mode; the network service is separately HSR.
    },
    {
      "id": "lower-channel-01", // Same channel at both ends; association follows actual permitted journeys.
      "component_id": "lower-mainline", // Logical route ownership, never a coordinate.
      "kind": "rail", // Physical passage kind; other domains can describe road lanes or walkways.
      "traffic_modes": ["monorail"] // Explicit game travel mode; the network service is separately HSR.
    },
    {
      "id": "lower-channel-02", // Same channel at both ends; association follows actual permitted journeys.
