          "source_port_id": "Nin", // Existing measured port in connections.json; its old name does not define geometry.
          "direction": "in", // Travel relative to this piece; checked against the measured source endpoint.
          "channel_id": "upper-channel-02", // Physical passage above; its other end can have a different member-number suffix.
          "cut_id": "upper-end-b-cut-01" // One physical crossing of this tile edge; a bidirectional cut may have several members.
        },
