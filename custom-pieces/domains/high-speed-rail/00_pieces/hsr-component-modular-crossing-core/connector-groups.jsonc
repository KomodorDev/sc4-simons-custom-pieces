  "boundary_bundles": [ // All groups at one particular source tile edge must join using the same placement.
    {
      "id": "cell-0-0-south", // Local reference for this physical source boundary.
      "source_cell": [0, 0], // Zero-based [column east, row south]: first column, first row.
      "edge": "south", // Tile edge in the authored orientation; independent of train travel direction.
      "connector_ids": ["upper-end-a"] // References group IDs above; additional levels/services on this same edge join this list.
    },
