// title: "Highway assembly menu layouts"
// summary: "Define independent component cycles for Highway assembly buttons."
//
// Used when: scp.py assembly-menu prepares this assembly from a verified normal build.
// Read by: The single and combined assembly-menu builders.
// Updated by: The domain registration tools and contributors following the assembly creation workflow.
// Affects: Component cycling order and assembly buttons inside the shared SCP Assemblies folder; geometry and game observations are separate.
{
  "schema_version": 1,
  "purpose": "One button per assembly cycles through its separately placed component types; each assembly button appears directly inside Highways > SCP > Assemblies.",
  "layouts": {
    "compact-diagonal-diamond": {
      "assembly_id": "ddrhw-l1-and-l2-diagonal-avenue-diamond",
      "member_order": "first-use-in-assembly",
      "cycle_button": {
        "id": "6a47fee0",
        "order": "fffffee0",
        "title": "SCP | ASSEMBLY | DD RHW-4 \u2014 Compact Diagonal Avenue Diamond",
        "description": "Tab and Shift+Tab select one reusable component; Home and End rotate it. Each click places one component. Follow the assembly placement table."
      }
    },
    "modular-diagonal-diamond": {
      "assembly_id": "ddrhw-l1-and-l2-diagonal-avenue-modular-diamond",
