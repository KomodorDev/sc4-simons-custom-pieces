// title: "Connector declaration schema"
// summary: "Validate authored physical channels, boundary cuts, associations, and permissions for an individual reusable piece."
{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 3
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "piece_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "source_binding": {
      "type": "object",
      "properties": {
        "piece_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "connections_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "piece_sha256",
        "connections_sha256"
      ],
      "additionalProperties": false
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "network": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "construction_network": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "network"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "component_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "kind": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "traffic_modes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "kind",
          "traffic_modes"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "component_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "profile_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "nominal_level": {
            "type": [
              "string",
              "null"
            ]
          },
          "members": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "source_port_id": {
                  "type": "string",
                  "minLength": 1
                },
                "direction": {
                  "enum": [
                    "in",
                    "out"
                  ]
                },
                "channel_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "cut_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "traffic_modes": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$"
                  },
                  "minItems": 1,
                  "uniqueItems": true
                }
              },
              "required": [
                "id",
                "source_port_id",
                "direction",
                "channel_id",
                "cut_id"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "section_offset_m": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "component_id",
          "members"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "boundary_bundles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "source_cell": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 2,
            "maxItems": 2
          },
          "edge": {
            "enum": [
              "north",
              "south",
              "east",
              "west"
            ]
          },
          "connector_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "source_cell",
          "edge",
          "connector_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "purpose",
    "piece_id",
    "source_binding",
    "components",
    "channels",
    "groups",
    "boundary_bundles"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SCP source connector declarations, version 3",
  "description": "Authored identities, physical channel/cut associations, and optional defaults. Measured geometry remains source-owned; semantic checks and source fingerprints are additionally required."
}
