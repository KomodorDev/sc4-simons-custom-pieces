{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SCP optional connector defaults, version 2",
  "description": "Optional inherited authoring defaults. Profile names, declared section widths, and mnemonic tokens do not decide compatibility.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 2
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "coordinate_convention": {
      "type": "object"
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "abstract": {
            "type": "boolean"
          },
          "extends": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "network": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "engine_transport": {
            "type": "integer",
            "minimum": 0
          },
          "role": {
            "type": "string"
          },
          "alignment": {
            "type": "string"
          },
          "endpoint_grade": {
            "type": "number"
          },
          "path_height_m": {
            "type": "number"
          },
          "nominal_level": {
            "type": [
              "string",
              "null"
            ]
          },
          "label": {
            "type": "string"
          },
          "scope_note": {
            "type": "string"
          }
        },
        "required": [
          "abstract"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "purpose",
    "profiles"
  ],
  "additionalProperties": false
}
