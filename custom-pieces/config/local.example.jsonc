// title: "Private workstation settings example"
// summary: "Copy this template to ignored local/settings.jsonc and supply this computer’s actual Plugins directories without publishing private paths."
{
  "purpose": "Copy to local/settings.jsonc, set plugins to your actual Plugins directory, and add any other active Plugins directories to extra_plugins. Keep local/settings.jsonc out of Git.",
  "plugins": "/absolute/path/to/user/Plugins",
  "extra_plugins": []
}
