// title: "Graphical installer policy"
// summary: "Select the supported game profile, implemented catalogue, assembly presentation, platforms, and installer distribution requirements."
//
// Used when: The graphical installer starts an installation, undoes its last installation, or runs its packaged self-test; bundle preparation includes this policy in the runtime.
// Read by: scp_installer.service._policy(), called by run_install(), undo_install(), and self_test(); run_install() also reads assembly_menu to select the assembly package.
// Updated by: A maintainer when changing the supported installer distribution, with matching service validation, packaging, tests, and player instructions.
// Affects: Whether the installer accepts its distribution policy and which domain and assembly layout it packages; descriptive platform and publication fields do not replace implementation checks or game observations.
// Reference: custom-pieces/docs/INSTALLER.md explains player actions, and docs/GITHUB.md describes automated installer publication.
{
  "schema_version": 1,
  "purpose": "Experimental installer distribution policy; local building does not establish public DAT redistribution permission or in-game verification.",
  "maturity": "experimental",
  "distribution": "local-builder",
  "selection": "all-implemented",
  "assembly_menu": {
    "domain": "high-speed-rail",
    "layout": "trumpet"
  },
  "supported_profile": "config/profiles/nam50-rhd.json",
  "supported_game": {
    "edition": "SimCity 4 Deluxe for Windows",
    "version": "1.1.641",
    "nam": "50",
    "drive_side": "right",
    "native_macos_supported": false,
    "compatibility_layer_game_tests": "unverified"
  },
  "installer_platforms": [
    "windows-x64"
  ],
  "requires_user_python": false,
  "bundles_nam_resources": false,
  "bundles_game_resources": false,
  "capture_policy": "Read exact source archives from the user's installed game and NAM, verify the recorded resource identities, and create required captures locally without modifying the originals.",
  "publication": {
    "channel": "prerelease",
    "trigger": "successful-main-push",
    "tag": "installer-<first-12-source-commit-hex>",
    "required_platforms": "windows-x64",
    "source_commit_required": true,
    "sha256_required": true,
    "windows_authenticode_signed": false
  },
  "manual_observations": "Preserve existing failed, stale, and unverified cases; installer and pipeline checks do not record game passes.",
  "compiled_plugin_release_policy": "config/release.json"
}
