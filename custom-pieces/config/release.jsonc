// title: "Compiled-plugin release requirements"
// summary: "Define the identity, dependency, verification, permission, and game-test gates for public compiled-plugin distribution."
//
// Used when: release-check reports compiled-plugin readiness, a build records release status, or package --release assesses whether a compiled candidate satisfies publication requirements.
// Read by: scp.catalog.release_status() for shared checks and installer.release_handoff.require_release_evidence() for the prebuilt installer setting.
// Updated by: A maintainer when choosing which checks to enforce or recording real release evidence.
// Affects: Release readiness and reported blockers for compiled packages and prebuilt installers.
// Reference: custom-pieces/docs/RELEASE.md defines the evidence requirements and the separate installer policy.
{
  "purpose": "Human evidence and release-readiness requirements; software checks do not constitute game testing.",
  "schema_version": 1,
  "public_name_checked": {
    "enabled": true,
    "status": "pending",
    "evidence": null
  },
  "ids_allocated": {
    "enabled": true,
    "status": "pending",
    "evidence": null
  },
  "nam_derivatives_permission": {
    "enabled": true,
    "status": "pending",
    "evidence": null
  },
  "supported_platform_tests": {
    "enabled": true,
    "status": "pending",
    "evidence": null
  },
  "simtropolis_description_and_game_images": {
    "enabled": true,
    "status": "pending",
    "evidence": null
  },
  "prebuilt_installer": {
    "require_build_game_evidence": false
  },
  "distribution_plan": "Build locally from user-installed NAM; public binary redistribution not cleared.",
  "published": false
}
