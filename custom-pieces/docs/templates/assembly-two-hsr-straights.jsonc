// title: "Two-straight HSR assembly starter"
// summary: "Provide an unregistered training placement plan for two existing paired straights without allocating another reusable piece type."
//
// Used when: A contributor follows section 12 of custom-pieces/docs/WORKFLOW_ASSEMBLY_CREATION.md to learn assembly authoring with two placements of the existing hsr-l2-two-track-straight type; this is an explicitly unverified training example.
//
// Read by: The section 12.1 Python command calls scp.jsonc.load() to read this commented template and writes a separate strict-JSON assembly.json; normal scp.catalog.load_catalog() calls do not read or register this template.
//
// Updated by: Contributors maintaining the shared assembly starter edit this template alongside its runnable workflow example when the referenced reusable type, expected placement plan, or required plan fields change.
//
// Affects: Only a deliberately created copy receives this placement plan; registering that copy and adding its menu layout are separate steps, no new piece-resource allocation is needed, and the template supplies no compiled geometry verification or game observations.
//
// Reference: custom-pieces/docs/WORKFLOW_ASSEMBLY_CREATION.md
{
  "purpose": "Unregistered authoring starter: place two copies of the existing HSR Level 2 two-track straight. Copy and deliberately register this plan before using the assembly workflow; this template supplies no new verification or game observations.",
  "title": "Two-tile HSR starter",
  "geometry_status": "Unverified starter. The positions and external ports are authored expectations; verify the compiled members, placed seams, models, supports, construction, and game behaviour separately.",
  "coordinate_units": "metres east,north,height; rotations counterclockwise",
  "construction_rectangle_tiles": [1, 2],
  "occupied_tiles": 2,
  "module_placements": 2,
  "component_types_used": 1,
  "external_ports": {
    "S": {
      "in": [2.0, -8.0, 15.5],
      "out": [-2.0, -8.0, 15.5]
    },
    "N": {
      "in": [-2.0, 24.0, 15.5],
      "out": [2.0, 24.0, 15.5]
    }
  },
  "placements": [
    {
      "name": "HSR Level 2 (15.5 m) \u2014 Two-Track Straight at P01",
      "instance_id": "P01",
      "label": "P01",
      "piece_id": "hsr-l2-two-track-straight",
      "menu_name": "HSR Level 2 (15.5 m) \u2014 Two-Track Straight",
      "origin_m": [0.0, 0.0],
      "rotation_degrees_ccw": 0,
      "display_origin_m": [0.0, 0.0],
      "display_origin_tiles_en": [0.0, 0.0]
    },
    {
      "name": "HSR Level 2 (15.5 m) \u2014 Two-Track Straight at P02",
      "instance_id": "P02",
      "label": "P02",
      "piece_id": "hsr-l2-two-track-straight",
      "menu_name": "HSR Level 2 (15.5 m) \u2014 Two-Track Straight",
      "origin_m": [0.0, 16.0],
      "rotation_degrees_ccw": 0,
      "display_origin_m": [0.0, 16.0],
      "display_origin_tiles_en": [0.0, 1.0]
    }
  ],
  "coordinate_system": {
    "layout": "two-tile-hsr-starter",
    "origin_name": "southwest tile centre of complete construction rectangle",
    "origin_world_m": [0.0, 0.0],
    "tile_size_m": 16.0,
    "axes": "east,north,height; S3D east,height,-north",
    "tile_boundaries_offset_m": 8.0,
    "display_tile_centres_bounds_en": [0, 0, 0, 1],
    "authoring_tile_centres_bounds_en": [0, 0, 0, 1]
  }
}
