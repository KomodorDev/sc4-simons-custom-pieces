// title: "Release branch protection template"
// summary: "Require Tests and Release policy checks for main while preserving human control of release merges."
{
  "required_status_checks": {
    "strict": true,
    "checks": [
      {"context": "Tests", "app_id": 15368},
      {"context": "Release policy", "app_id": 15368}
    ]
  },
  "enforce_admins": true,
  "required_pull_request_reviews": {
    "required_approving_review_count": 0
  },
  "restrictions": null,
  "required_conversation_resolution": true,
  "allow_force_pushes": false,
  "allow_deletions": false
}
